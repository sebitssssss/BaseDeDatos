<?xml version="1.0" encoding="utf-8"?>
<!-- Fuente de títulos. Arial viene instalada en Windows. -->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>34</Size>
    <Spacing>2</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <!-- Si aparece un carácter que la fuente no tiene, se dibuja este en su lugar. -->
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <!-- ASCII imprimible -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Latin-1: á é í ó ú ñ ¡ ¿ · -->
      <CharacterRegion>
        <Start>&#161;</Start>
        <End>&#255;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
