<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RootNamespace>CodeBreaker</RootNamespace>
    <AssemblyName>CodeBreaker</AssemblyName>
    <!-- Sin "usings" implícitos ni anotaciones de null: todo queda escrito a la vista. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.conf de ejemplo: se copia al lado del ejecutable. -->
    <None Update="config.conf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Spritesheets descargados (PNG + XML): se copian a bin/.../Content/Sprites. -->
    <None Update="Content\Sprites\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\Sprites\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
